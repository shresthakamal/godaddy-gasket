{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "DOM"
    ],
    "types": []
  },
  "exclude": [
    "test",
    "coverage",
    "lib",
    "cjs"
  ]
}
