{
  "name": "@godaddy/gasket-content-nodes",
  "version": "3.1.1",
  "description": "Intermediate exchange format of content originating from a CMS",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "docs",
    "cjs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build && gasket-cjs ./lib",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf lib cjs",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "posttest": "npm run test:types && npm run lint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:speed": "vitest --no-cache speed-tests.spec.ts",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "repository": "gdcorp-uxp/pfx-storefront.git",
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "cms",
    "content",
    "gasket",
    "plugin"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "maintainers": [
    "Andrew Gerard <agerard@godaddy.com>"
  ],
  "license": "UNLICENSED",
  "bugs": "https://github.com/gdcorp-uxp/pfx-storefront/issues",
  "homepage": "https://github.com/gdcorp-uxp/pfx-storefront/tree/main/packages/content-nodes",
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@types/node": "^22.18.6",
    "@vitest/eslint-plugin": "^1.1.44",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "module": "lib/index.js"
}
