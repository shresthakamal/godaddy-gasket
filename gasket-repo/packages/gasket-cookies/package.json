{
  "name": "@godaddy/gasket-cookies",
  "version": "3.3.9",
  "description": "Reads cookies from request/document and loads in redux store",
  "main": "lib/index.js",
  "types": "src/index.d.ts",
  "files": [
    "reducers.js",
    "src",
    "lib",
    ".babelrc",
    "EXAMPLES.md"
  ],
  "scripts": {
    "build": "babel src -d lib --ignore '**/*.spec.js' --delete-dir-on-start",
    "clean": "rimraf lib",
    "lint": "eslint src",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run lint && pnpm run typecheck",
    "prepublishOnly": "pnpm run build",
    "test": "cross-env NODE_OPTIONS='--unhandled-rejections=strict' jest",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "pnpm run test --watch",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-cookies"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-cookies",
  "dependencies": {
    "cookie": "^0.5.0",
    "hoist-non-react-statics": "^3.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/runtime": "^7.26.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "babel-eslint": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "redux": "^4.2.1",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.4",
    "react-dom": "^18.3.1 || ^19.2.4"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react"
    ],
    "plugins": [
      "@babel/plugin-proposal-object-rest-spread",
      [
        "@babel/plugin-transform-runtime",
        {
          "regenerator": true
        }
      ]
    ]
  },
  "deprecated": "Package deprecated and will be removed in future major release."
}
