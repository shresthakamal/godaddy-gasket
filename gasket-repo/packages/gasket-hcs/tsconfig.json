{
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": [
      "esnext",
      "DOM"
    ],
    "types": [
      "@types/node"
    ]
  },
  "include": [
    "src"
  ]
}
