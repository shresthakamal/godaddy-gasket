{
  "name": "@godaddy/gasket-header-nav",
  "version": "3.7.3",
  "description": "Provides SPA navigation capabilities to the UXP application header navigation links",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "src",
    "cjs",
    "lib",
    "EXAMPLES.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./cjs/index.cjs"
    },
    "./layout": {
      "types": "./lib/layout/index.d.ts",
      "import": "./lib/layout/index.js",
      "require": "./cjs/layout/index.cjs",
      "default": "./cjs/layout/index.cjs"
    }
  },
  "scripts": {
    "build": "tsc --build && gasket-cjs ./lib",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf lib cjs",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run lint && pnpm run typecheck",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --globals",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "vitest --watch --globals",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-header-nav"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "application-header",
    "gasket",
    "react",
    "uxcore2",
    "uxp"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-header-nav",
  "dependencies": {
    "hoist-non-react-statics": "^3.3.2"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@gasket/cjs": "^7.0.2",
    "@testing-library/react": "^16.2.0",
    "@types/hoist-non-react-statics": "^3.3.7",
    "@types/react": "^19",
    "@vitest/ui": "^3.2.0",
    "eslint-plugin-json": "^3.1.0",
    "jsdom": "^25.0.1",
    "next": "^16.1.6",
    "next-router-mock": "^0.9.13",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "next": ">=14 <17",
    "react": "^18.3.1 || ^19.2.4",
    "react-dom": "^18.3.1 || ^19.2.4"
  },
  "babel": {
    "presets": [
      "@babel/preset-react",
      [
        "@babel/preset-env",
        {
          "targets": {
            "browsers": [
              "last 2 versions"
            ]
          }
        }
      ]
    ]
  }
}
