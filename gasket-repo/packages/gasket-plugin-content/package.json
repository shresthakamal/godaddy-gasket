{
  "name": "@godaddy/gasket-plugin-content",
  "version": "3.2.4",
  "description": "Gasket Plugin for retrieving CMS content",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "docs",
    "cjs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./cjs/index.cjs"
    },
    "./transforms/*": {
      "types": "./lib/transforms/*.d.ts",
      "import": "./lib/transforms/*.js",
      "require": "./cjs/transforms/*.cjs",
      "default": "./cjs/transforms/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build && gasket-cjs ./lib",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf lib cjs",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "posttest": "npm run test:types && npm run lint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "repository": "gdcorp-uxp/pfx-storefront.git",
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "cms",
    "content",
    "gasket",
    "plugin"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "maintainers": [
    "Andrew Gerard <agerard@godaddy.com>"
  ],
  "license": "UNLICENSED",
  "bugs": "https://github.com/gdcorp-uxp/pfx-storefront/issues",
  "homepage": "https://github.com/gdcorp-uxp/pfx-storefront/tree/main/packages/gasket-plugin-content",
  "dependencies": {
    "@godaddy/gasket-content-nodes": "workspace:^",
    "cookie": "^0.5.0",
    "node-html-parser": "^5.4.2"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/plugin-express": "^7.4.1",
    "@gasket/plugin-fastify": "^7.4.3",
    "@gasket/plugin-logger": "^7.3.5",
    "@gasket/plugin-metadata": "^7.4.4",
    "@types/cookie": "^0.5.4",
    "@types/inquirer": "^8.2.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19",
    "@vitest/eslint-plugin": "^1.1.44",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "eslintConfig": {
    "extends": [
      "godaddy-typescript"
    ],
    "plugins": [
      "unicorn",
      "@vitest"
    ],
    "rules": {
      "unicorn/filename-case": "error"
    },
    "env": {
      "@vitest/env": true
    }
  },
  "eslintIgnore": [
    "lib"
  ],
  "module": "lib/index.js"
}
