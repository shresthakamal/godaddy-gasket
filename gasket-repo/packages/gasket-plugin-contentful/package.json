{
  "name": "@godaddy/gasket-plugin-contentful",
  "version": "3.4.0",
  "description": "Storefront plugin for Contentful CMS",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "cjs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build && gasket-cjs ./lib",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf lib cjs",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "posttest": "npm run test:types && npm run lint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "repository": "gdcorp-uxp/pfx-storefront.git",
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "contentful",
    "gasket",
    "plugin",
    "storefront"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "maintainers": [
    "Michael Mason <mmason2@godaddy.com>",
    "Nick Scuilla <nscuilla@godaddy.com>"
  ],
  "license": "UNLICENSED",
  "bugs": "https://github.com/gdcorp-uxp/pfx-storefront/issues",
  "homepage": "https://github.com/gdcorp-uxp/pfx-storefront#readme",
  "dependencies": {
    "@contentful/rich-text-types": "^16.8.5",
    "@gasket/fetch": "^7.3.6",
    "@godaddy/gasket-content-nodes": "workspace:^",
    "@godaddy/gasket-plugin-content": "workspace:^",
    "contentful": "^11.5.12",
    "node-cache": "^5.1.2",
    "string-hash": "^1.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/plugin-command": "^7.5.1",
    "@gasket/plugin-logger": "^7.3.5",
    "@gasket/plugin-metadata": "^7.4.4",
    "@types/jest": "^29.5.14",
    "@vitest/eslint-plugin": "^1.1.44",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "eslintConfig": {
    "extends": [
      "godaddy-typescript"
    ],
    "plugins": [
      "unicorn",
      "@vitest"
    ],
    "rules": {
      "unicorn/filename-case": "error"
    },
    "env": {
      "@vitest/env": true
    }
  },
  "eslintIgnore": [
    "lib"
  ],
  "module": "lib/index.js"
}
