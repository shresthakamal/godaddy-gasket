{
  "name": "@godaddy/gasket-plugin-hcs",
  "version": "4.14.1",
  "description": "Header Content Service plugin for @gasket",
  "type": "module",
  "main": "cjs/index.cjs",
  "types": "lib/index.d.ts",
  "files": [
    "generator",
    "!lib/**/*.test.js",
    "lib",
    "babel.config.js",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs"
    },
    "./lib/*": {
      "import": "./lib/*",
      "require": "./cjs/*"
    },
    "./cjs": "./cjs/index.cjs",
    "./cjs/*": "./cjs/*"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "clean": "rm -rf cjs",
    "lint": "eslint . --ignore-pattern \"generator/jest/*\" --ignore-pattern \"generator/mocha/*\" --ignore-pattern \"cjs/*\"",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run lint && pnpm run typecheck",
    "rebuild": "pnpm run clean && pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-hcs"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "configuration",
    "content",
    "gasket",
    "hcs",
    "header",
    "service",
    "webpack"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-hcs",
