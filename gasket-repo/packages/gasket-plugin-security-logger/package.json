{
  "name": "@godaddy/gasket-plugin-security-logger",
  "version": "3.4.0",
  "description": "Application security logger plugin for @gasket",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run build && pnpm run lint && pnpm run typecheck",
    "test": "vitest run --globals",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "vitest --globals",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-security-logger"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "gasket",
    "logger",
    "logging",
    "plugin",
    "security"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-security-logger",
  "dependencies": {
    "@gasket/plugin-winston": "^7.3.5",
    "@godaddy/security-logger": "^1.9.0"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/plugin-logger": "^7.3.5",
    "@gasket/plugin-metadata": "^7.4.4",
    "@types/node": "^22.18.6",
    "babel-eslint": "^10.1.0",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@gasket/plugin-logger": "^7.3.5"
  }
}
