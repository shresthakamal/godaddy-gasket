{
  "name": "@godaddy/gasket-plugin-security",
  "version": "3.4.0",
  "description": "Security features for gasket",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./get-content-security-policy": {
      "import": "./lib/get-content-security-policy.js",
      "require": "./cjs/get-content-security-policy.js",
      "default": "./lib/get-content-security-policy.js"
    }
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run build && pnpm run lint && pnpm run typecheck",
    "test": "vitest run --globals",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "vitest --globals",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-security"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "gasket",
    "helmet",
    "middleware",
    "security"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-security",
  "dependencies": {
    "helmet": "^7.2.0",
    "lodash.clonedeep": "^4.5.0",
    "lru-cache": "^5.1.1",
    "nanoid": "^3.3.9"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/plugin-command": "^7.5.1",
    "@gasket/plugin-elastic-apm": "^7.4.3",
    "@gasket/plugin-express": "^7.4.1",
    "@gasket/plugin-logger": "^7.3.5",
    "@gasket/plugin-metadata": "^7.4.4",
    "@gasket/plugin-middleware": "^7.4.3",
    "@types/node": "^22.18.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  }
}
