{
  "name": "@godaddy/gasket-plugin-shared-header",
  "version": "3.4.1",
  "description": "The P&C shared header gasket plugin",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run build && pnpm run lint && pnpm run typecheck",
    "test": "vitest run --globals",
    "test:coverage": "pnpm test --coverage",
    "test:watch": "vitest --globals",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-shared-header"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "header",
    "pc",
    "shared"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-shared-header",
  "dependencies": {
    "@wsb/shared-header-client": "^7.5.0"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/plugin-logger": "^7.3.5",
    "@godaddy/gasket-plugin-uxp": "workspace:^",
    "@godaddy/gasket-plugin-visitor": "workspace:^",
    "@types/node": "^22.18.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "@godaddy/gasket-plugin-uxp": "^3.4.3",
    "@godaddy/gasket-plugin-visitor": "^3.4.2"
  }
}
