{
  "name": "@godaddy/gasket-plugin-switchboard",
  "version": "3.7.1",
  "description": "Switchboard integration for Gasket apps",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "src",
    "EXAMPLES.md",
    "cjs"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json && gasket-cjs ./lib",
    "build:watch": "tsc --build --watch",
    "clean": "rimraf lib cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "posttest": "pnpm run lint && pnpm run typecheck",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-switchboard"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-switchboard",
  "dependencies": {
    "@switchboard/client": "^2.8.1",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/plugin-data": "^7.4.3",
    "@gasket/plugin-https": "^7.3.8",
    "@gasket/plugin-logger": "^7.3.5",
    "@gasket/plugin-metadata": "^7.4.4",
    "@gasket/plugin-middleware": "^7.4.3",
    "@gasket/plugin-redux": "^7.4.2",
    "@gasket/plugin-webpack": "^7.4.0",
    "@gasket/request": "^7.4.3",
    "@godaddy/gasket-plugin-auth": "workspace:^",
    "@godaddy/gasket-plugin-otel": "workspace:^",
    "@godaddy/gasket-plugin-visitor": "workspace:^",
    "@tsconfig/node20": "^20.1.6",
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.15",
    "@types/webpack": "^5.28.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
