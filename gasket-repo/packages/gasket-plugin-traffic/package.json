{
  "name": "@godaddy/gasket-plugin-traffic",
  "version": "3.6.0",
  "description": "Gasket plugin relating to Traffic (traffic2) functionality",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "build:watch": "pnpm run build --watch",
    "lint": "eslint ./lib ./test",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run lint && pnpm run typecheck",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --globals",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "vitest --watch --globals",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-traffic"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "gasket",
    "tcc",
    "traffic",
    "traffic2"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-traffic",
  "dependencies": {
    "@gasket/core": "^7.7.3",
    "@gasket/request": "^7.4.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/plugin-command": "^7.5.1",
    "@gasket/plugin-metadata": "^7.4.4",
    "@godaddy/gasket-plugin-switchboard": "workspace:^",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.6",
    "create-gasket-app": "^7.4.19",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  }
}
