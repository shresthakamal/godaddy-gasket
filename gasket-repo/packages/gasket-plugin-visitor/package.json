{
  "name": "@godaddy/gasket-plugin-visitor",
  "version": "3.10.0",
  "description": "Determine users details for use in other plugins",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run build && pnpm run lint && pnpm run typecheck",
    "test": "vitest run",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-plugin-visitor"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "central",
    "configuration",
    "gasket",
    "presentation",
    "uxcore2",
    "webpack"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-plugin-visitor",
  "dependencies": {
    "@gasket/request": "^7.4.3",
    "@godaddy/atlas": "^1.2.1",
    "negotiator": "^1.0.0"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@gasket/core": "^7.7.3",
    "@gasket/intl": "^7.4.0",
    "@gasket/plugin-intl": "^7.5.4",
    "@gasket/plugin-metadata": "^7.4.4",
    "@godaddy/gasket-plugin-atlas": "workspace:^",
    "@types/node": "^22.18.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  }
}
