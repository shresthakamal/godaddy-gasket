{
  "name": "@godaddy/gasket-preset-webapp",
  "version": "3.5.0",
  "description": "Gasket preset for GoDaddy web apps",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "generator",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs",
      "default": "./cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "build:watch": "pnpm run build --watch",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run lint",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --globals",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "vitest --watch --globals"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-preset-webapp"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-preset-webapp",
  "dependencies": {
    "@gasket/plugin-analyze": "^7.3.6",
    "@gasket/plugin-command": "^7.5.1",
    "@gasket/plugin-cypress": "^7.5.1",
    "@gasket/plugin-data": "^7.4.3",
    "@gasket/plugin-docs": "^7.4.3",
    "@gasket/plugin-docusaurus": "^7.4.3",
    "@gasket/plugin-dynamic-plugins": "^7.3.8",
    "@gasket/plugin-express": "^7.4.1",
    "@gasket/plugin-git": "^7.4.2",
    "@gasket/plugin-https": "^7.3.8",
    "@gasket/plugin-https-proxy": "^7.3.12",
    "@gasket/plugin-intl": "^7.5.4",
    "@gasket/plugin-jest": "^7.5.3",
    "@gasket/plugin-lint": "^7.4.3",
    "@gasket/plugin-logger": "^7.3.5",
    "@gasket/plugin-metadata": "^7.4.4",
    "@gasket/plugin-mocha": "^7.5.3",
    "@gasket/plugin-nextjs": "^7.5.6",
    "@gasket/plugin-typescript": "^7.4.4",
    "@gasket/plugin-vitest": "^7.0.3",
    "@gasket/plugin-webpack": "^7.4.0",
    "@gasket/plugin-winston": "^7.3.5",
    "@godaddy/gasket-plugin-atlas": "workspace:^",
    "@godaddy/gasket-plugin-auth": "workspace:^",
    "@godaddy/gasket-plugin-dev-certs": "workspace:^",
    "@godaddy/gasket-plugin-otel": "workspace:^",
    "@godaddy/gasket-plugin-security": "workspace:^",
    "@godaddy/gasket-plugin-self-certs": "workspace:^",
    "@godaddy/gasket-plugin-traffic": "workspace:^",
    "@godaddy/gasket-plugin-uxp": "workspace:^",
    "@godaddy/gasket-plugin-visitor": "workspace:^"
  },
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "nodemon": "^3.1.10",
    "vitest": "^3.2.0"
  }
