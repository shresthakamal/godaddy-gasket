{
  "name": "gasket-template-api-express",
  "version": "0.0.0",
  "description": "Gasket App",
  "scripts": {
    "docs": "tsx gasket.ts docs",
    "prebuild": "tsx gasket.ts build",
    "build": "tsc",
    "preview": "npm run build && npm run start",
    "start": "NODE_OPTIONS='--import @godaddy/gasket-otel/register' node dist/server.js",
    "local": "tsx watch server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ext .js,.jsx,.cjs,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "@gasket/core": "^7.7.3",
    "@gasket/data": "^7.5.5",
    "@gasket/plugin-command": "^7.6.4",
    "@gasket/plugin-data": "^7.5.2",
    "@gasket/plugin-dynamic-plugins": "^7.5.1",
    "@gasket/plugin-express": "^7.5.1",
    "@gasket/plugin-https": "^7.4.1",
    "@gasket/plugin-logger": "^7.4.0",
    "@gasket/plugin-swagger": "^7.4.0",
    "@gasket/plugin-winston": "^7.4.0",
    "@gasket/request": "^7.5.5",
    "@gasket/utils": "^7.6.5",
    "@godaddy/gasket-otel": "^3.4.0",
    "@godaddy/gasket-plugin-dev-certs": "^3.5.0",
    "@godaddy/gasket-plugin-otel": "^3.5.0",
    "@godaddy/gasket-plugin-security": "^3.4.0",
    "@godaddy/gasket-plugin-self-certs": "^3.4.0",
    "@godaddy/gasket-plugin-visitor": "^3.7.1",
    "@godaddy/gasket-utils": "^3.0.0",
    "express": "^4.21.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@gasket/plugin-docs": "^7.5.4",
    "@gasket/plugin-docusaurus": "^7.5.1",
    "@gasket/plugin-metadata": "^7.5.9",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.17.1",
    "eslint": "^8.57.1",
    "eslint-config-godaddy": "^7.1.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^18.3.1 || ^19.2.4",
    "react-dom": "^18.3.1 || ^19.2.4",
    "search-insights": "^2.17.3",
    "supertest": "^6.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  },
  "type": "module",
  "eslintIgnore": [
    "dist",
    "coverage/",
    "build/"
  ],
  "eslintConfig": {
    "extends": [
      "godaddy"
    ],
    "parser": "@typescript-eslint/parser"
  }
}
