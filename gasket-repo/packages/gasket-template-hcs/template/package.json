{
  "name": "gasket-template-hcs",
  "version": "0.0.0",
  "description": "Gasket App",
  "scripts": {
    "build:watch": "nodemon --exec \"npm run build\" --ignore ./build/* --ignore intl.js --ignore swagger.json",
    "docs": "node gasket.js docs",
    "build": "node gasket.js build",
    "start": "node server.js",
    "local": "GASKET_ENV=local nodemon server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ext .js,.jsx,.cjs .",
    "lint:fix": "npm run lint -- --fix",
    "posttest": "npm run lint"
  },
  "dependencies": {
    "@gasket/core": "^7.7.3",
    "@gasket/data": "^7.5.5",
    "@gasket/intl": "^7.5.3",
    "@gasket/plugin-command": "^7.6.4",
    "@gasket/plugin-data": "^7.5.2",
    "@gasket/plugin-dynamic-plugins": "^7.5.1",
    "@gasket/plugin-express": "^7.5.1",
    "@gasket/plugin-https": "^7.4.1",
    "@gasket/plugin-intl": "^7.6.4",
    "@gasket/plugin-logger": "^7.4.0",
    "@gasket/plugin-swagger": "^7.4.0",
    "@gasket/plugin-webpack": "^7.4.0",
    "@gasket/plugin-winston": "^7.4.0",
    "@gasket/react-intl": "^7.7.1",
    "@gasket/request": "^7.5.5",
    "@gasket/utils": "^7.6.5",
    "@godaddy/gasket-hcs": "^3.6.2",
    "@godaddy/gasket-plugin-hcs": "^4.11.1",
    "@godaddy/gasket-plugin-security": "^3.4.0",
    "@godaddy/gasket-plugin-visitor": "^3.7.1",
    "@godaddy/gasket-utils": "^3.0.0",
    "babel-loader": "^8.4.1",
    "express": "^4.21.2",
    "react": "^18.3.1 || ^19.2.4",
    "react-dom": "^18.3.1 || ^19.2.4",
    "react-intl": "^7.1.6",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/core": ">=7",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@gasket/plugin-docs": "^7.5.4",
    "@gasket/plugin-docusaurus": "^7.5.1",
    "@gasket/plugin-metadata": "^7.5.9",
    "@godaddy/eslint-plugin-react-intl": "^1.3.0",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.17.1",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.4.1",
    "eslint": "^8.57.1",
    "eslint-config-godaddy-react": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "nodemon": "^3.1.10",
    "search-insights": "^2.17.3",
    "supertest": "^6.3.3",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0",
    "webpack": "^5.98.0"
  },
  "type": "module",
  "eslintConfig": {
    "extends": [
      "godaddy-react",
      "plugin:@godaddy/react-intl/recommended"
    ],
    "settings": {
      "localeFiles": [
        "locales/en-US.json"
      ]
    }
  },
  "eslintIgnore": [
    "coverage/",
    "build/"
  ]
}
