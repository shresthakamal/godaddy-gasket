{
  "name": "gasket-template-webapp-pages",
  "version": "0.0.0",
  "description": "Gasket App",
  "scripts": {
    "analyze": "GASKET_ENV=local.analyze next build --webpack",
    "docs": "tsx gasket.ts docs",
    "build": "npm run build:tsc && next build --webpack",
    "start": "NODE_OPTIONS='--import @godaddy/gasket-otel/register' NEXT_OTEL_VERBOSE=1 npm run start:https & next start",
    "local": "concurrently \"npm run build:tsc:watch\" \"npm run local:https\" \"next dev --webpack\"",
    "preview": "npm run build && npm run start",
    "prebuild": "tsx gasket.ts build",
    "start:https": "node dist/server.js",
    "local:https": "tsx watch server.ts",
    "build:tsc:watch": "tsc -p ./tsconfig.server.json --watch",
    "build:tsc": "tsc -p ./tsconfig.server.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --ext .js,.jsx,.cjs,.ts,.tsx .",
    "lint:fix": "npm run lint -- --fix",
    "stylelint": "stylelint \"**/*.css\"",
    "stylelint:fix": "npm run stylelint -- --fix",
    "posttest": "npm run lint && npm run stylelint"
  },
  "dependencies": {
    "@gasket/assets": "^7.5.1",
    "@gasket/core": "^7.7.3",
    "@gasket/data": "^7.5.5",
    "@gasket/intl": "^7.5.3",
    "@gasket/nextjs": "^7.6.8",
    "@gasket/plugin-command": "^7.6.4",
    "@gasket/plugin-data": "^7.5.2",
    "@gasket/plugin-dynamic-plugins": "^7.5.1",
    "@gasket/plugin-https-proxy": "^7.5.0",
    "@gasket/plugin-intl": "^7.6.4",
    "@gasket/plugin-logger": "^7.4.0",
    "@gasket/plugin-nextjs": "^7.7.4",
    "@gasket/plugin-webpack": "^7.4.0",
    "@gasket/plugin-winston": "^7.4.0",
    "@gasket/react-intl": "^7.7.1",
    "@gasket/request": "^7.5.5",
    "@gasket/utils": "^7.6.5",
    "@godaddy/browserslist-config": "^3.1.0",
    "@godaddy/gasket-auth": "^3.4.1",
    "@godaddy/gasket-next": "^3.7.1",
    "@godaddy/gasket-otel": "^3.4.0",
    "@godaddy/gasket-plugin-atlas": "^3.1.0",
    "@godaddy/gasket-plugin-auth": "^3.7.1",
    "@godaddy/gasket-plugin-dev-certs": "^3.5.0",
    "@godaddy/gasket-plugin-otel": "^3.5.0",
    "@godaddy/gasket-plugin-security": "^3.4.0",
    "@godaddy/gasket-plugin-self-certs": "^3.4.0",
    "@godaddy/gasket-plugin-traffic": "^3.5.1",
    "@godaddy/gasket-plugin-uxp": "^3.7.1",
    "@godaddy/gasket-plugin-visitor": "^3.7.1",
    "@godaddy/gasket-utils": "^3.0.0",
    "@godaddy/react-mintl": "^3.1.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "@types/react": "^19.0.12",
    "@ux/box": "^2500.3.2",
    "@ux/button": "^2500.10.0",
    "@ux/card": "^2500.3.2",
    "@ux/icon": "^2500.3.2",
    "@ux/intents": "^2500.3.2",
    "@ux/pivot": "^2500.3.2",
    "@ux/text": "^2500.3.2",
    "@vercel/otel": "^1.12.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-transition-group": "^4.4.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@babel/core": ">=7",
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@gasket/plugin-analyze": "^7.4.2",
    "@gasket/plugin-docs": "^7.5.4",
    "@gasket/plugin-docusaurus": "^7.5.1",
    "@gasket/plugin-metadata": "^7.5.9",
    "@godaddy/postcss-merge-selectors": "^1.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^14.0.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.17.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-config-godaddy-react": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "file-loader": "^6.2.0",
    "jsdom": "^20.0.3",
    "postcss": "^8.5.3",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^7.8.3",
    "@ux/postcss-intents": "^2500.9.0",
    "search-insights": "^2.17.3",
    "stylelint": "^15",
    "stylelint-config-godaddy": "^0.6.0",
    "typescript": "^5.8.2",
    "url-loader": "^4.1.1",
    "vitest": "^3.2.0",
    "webpack": "^5.98.0"
  },
  "type": "module",
  "eslintIgnore": [
    "dist",
    "coverage/",
    "build/",
    "next-env.d.ts"
  ],
  "browserslist": [
    "extends @godaddy/browserslist-config"
  ],
  "postcss": {
    "plugins": {
      "@ux/postcss-intents": {},
      "postcss-flexbugs-fixes": {},
      "postcss-preset-env": {
        "autoprefixer": {
          "flexbox": "no-2009"
        },
        "stage": 3,
        "features": {
          "custom-properties": false
        }
      },
      "@godaddy/postcss-merge-selectors": {
        "matchers": [
          "^\\*$"
        ]
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "godaddy-react"
    ],
    "parser": "@typescript-eslint/parser"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-godaddy"
    ]
  },
  "overrides": {
    "@aws-sdk/nested-clients": "3.988.0"
  }
}
