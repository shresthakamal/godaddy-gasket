{
  "name": "@godaddy/gasket-utils",
  "version": "3.0.1",
  "description": "Gasket utility functions",
  "type": "module",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cjs",
    "EXAMPLES.md"
  ],
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "gasket-cjs ./lib",
    "build:watch": "pnpm run build --watch",
    "lint": "eslint ./lib ./test",
    "lint:fix": "pnpm run lint --fix",
    "posttest": "pnpm run lint && pnpm run typecheck",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run --globals",
    "test:coverage": "pnpm run test --coverage",
    "test:watch": "vitest --watch --globals",
    "typecheck": "tsc",
    "typecheck:watch": "pnpm run typecheck --watch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gdcorp-uxp/gasket.git",
    "directory": "packages/gasket-utils"
  },
  "publishConfig": {
    "registry": "https://gdartifactory1.jfrog.io/artifactory/api/npm/npm-gasket-core-local/"
  },
  "keywords": [
    "gasket",
    "godaddy",
    "utils"
  ],
  "author": "GoDaddy Operating Company, LLC",
  "license": "UNLICENSED",
  "homepage": "https://github.com/gdcorp-uxp/gasket/tree/main/packages/gasket-utils",
  "dependencies": {},
  "devDependencies": {
    "@gasket/cjs": "^7.0.2",
    "@types/node": "^22.18.6",
    "typescript": "^5.8.2",
    "vitest": "^3.2.0"
  }
}
